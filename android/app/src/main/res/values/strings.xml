    <!-- How it was read; shown only when something is worth saying. -->
    <string name="note_mirrored">mirror image</string>
    <string name="note_bent">bent surface</string>
    <plurals name="note_repaired_stars">
        <item quantity="one">%d star repaired</item>
        <item quantity="other">%d stars repaired</item>
    </plurals>
    <plurals name="note_repaired_pairs">
        <item quantity="one">%d star pair repaired</item>
        <item quantity="other">%d star pairs repaired</item>
    </plurals>

    <!-- Frame size and the time the last scan took, for judging performance. -->
    <string name="status">%1$d × %2$d · %3$d ms</string>
